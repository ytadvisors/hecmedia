{
  "category": {
    "page": "category/[proxy]",
    "pattern": "/category/:proxy+"
  },
  "event": {
    "page": "event/[slug]",
    "pattern": "/event/:slug"
  },
  "event_filter": {
    "page": "event_filter/[category]/[day]",
    "pattern": "/event_filter/:category/:day"
  },
  "magazines": {
    "page": "magazines",
    "pattern": "/magazines"
  },
  "posts": {
    "page": "posts/[slug]",
    "pattern": "/posts/:slug"
  },
  "": {
    "page": "[page]",
    "pattern": "/[page]"
  }
}
