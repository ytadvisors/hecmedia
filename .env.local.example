# Local overrides for pointing the HECMedia app at the MBA-local Docker WordPress
# dev instance (task #82651, dev-infra/wordpress/) instead of production
# prod-wp.hectv.org. Copy to .env.local (gitignored) or export before `yarn dev`.
#
# Production defaults (baked into next.config.test.js / used when these are
# unset) are untouched by this file's existence — see tests/e2e/support/config.js.

GATSBY_WP_HOST=http://localhost:8091
WP_HOST=http://localhost:8091
APOLLO_CLIENT_URI=http://localhost:8091/graphql

# If running the e2e suite against the local instance:
#   E2E_ALLOW_WRITES=1   (writeGuard.js only allows this when the target host
#                          resolves to localhost/127.0.0.1/*staging* — see
#                          tests/e2e/support/writeGuard.js. It always refuses
#                          prod-wp.hectv.org, hectv.org, hecmedia.org.)
