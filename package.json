{
  "name": "hecmedia",
  "version": "1.0.0",
  "description": "HEC Media ReactJS application setup to run with nextjs and serverless",
  "main": "index.js",
  "repository": {
    "type": "git",
    "url": "git@github.com:ytadvisors/hecmedia.git"
  },
  "keywords": [
    "serverless",
    "nextjs",
    "lambda"
  ],
  "author": "YT Advisors <admin@ytadvisors.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/ytadvisors/hecmedia/issues"
  },
  "jest": {
    "automock": false,
    "testRegex": "\\.test\\.js$",
    "moduleNameMapper": {
      "\\.(css|less|sass|scss)$": "<rootDir>/__mocks__/jest/styleMock.js",
      "\\.(gif|ttf|eot|svg|png)$": "<rootDir>/__mocks__/jest/fileMock.js"
    }
  },
  "husky": {
    "hooks": {
      "pre-commit": "NODE_ENV=production lint-staged"
    }
  },
  "lint-staged": {
    "*.{js,jsx,css}": [
      "pretty-quick --staged",
      "eslint --fix",
      "git add"
    ]
  },
  "homepage": "https://github.com/ytadvisors/hecmedia#readme",
  "scripts": {
    "dev": "node server.js",
    "build": "next build",
    "start": "next start",
    "deploy": "serverless",
    "lint": "eslint .",
    "lint:fix": "eslint --fix ."
  },
  "dependencies": {
    "@apollo/react-common": "3.1.1",
