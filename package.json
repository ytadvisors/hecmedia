{
  "name": "hecmedia",
  "version": "1.0.0",
  "description": "HEC Media ReactJS application setup to run with nextjs and serverless",
  "main": "index.js",
  "repository": {
    "type": "git",
    "url": "git@github.com:ytadvisors/hecmedia.git"
  },
  "keywords": [
    "serverless",
    "nextjs",
    "lambda"
  ],
  "author": "YT Advisors <admin@ytadvisors.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/ytadvisors/hecmedia/issues"
  },
  "jest": {
    "automock": false,
    "testRegex": "\\.test\\.js$",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "<rootDir>/tests/e2e/"
    ],
    "moduleNameMapper": {
      "\\.(css|less|sass|scss)$": "<rootDir>/__mocks__/jest/styleMock.js",
      "\\.(gif|ttf|eot|svg|png)$": "<rootDir>/__mocks__/jest/fileMock.js"
    },
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.js"
    ],
    "collectCoverage": true,
    "collectCoverageFrom": [
      "components/**/*.js",
      "containers/**/*.js",
      "pages/**/*.js",
      "lib/**/*.js",
      "store/**/*.js",
      "!components/**/styles.scss",
      "!store/sagas/**",
      "!store/index.js",
      "!store/reducers/index.js",
      "!**/*.test.js"
    ],
    "coverageDirectory": "<rootDir>/coverage",
    "coverageThreshold": {
      "global": {
        "statements": 22,
        "lines": 22,
        "branches": 12,
        "functions": 14
      },
      "./store/actions/**/*.js": {
        "statements": 100,
        "lines": 100,
        "branches": 100,
        "functions": 100
      },
      "./store/api/**/*.js": {
        "statements": 100,
        "lines": 100,
        "branches": 0,
        "functions": 100
      },
      "./store/reducers/*Reducers.js": {
        "statements": 80,
        "lines": 80,
        "branches": 70,
        "functions": 100
      }
    }
  },
  "husky": {
    "hooks": {
      "pre-commit": "NODE_ENV=production lint-staged"
    }
  },
  "lint-staged": {
    "*.{js,jsx,css}": [
      "pretty-quick --staged",
      "eslint --fix",
      "git add"
    ]
  },
  "homepage": "https://github.com/ytadvisors/hecmedia#readme",
  "scripts": {
    "dev": "node server.js",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:e2e": "jest --config jest.e2e.config.js",
    "test:acceptance": "playwright test",
    "production:build": "node scripts/production-deploy.js build",
    "production:deploy": "node scripts/production-deploy.js deploy",
    "production:rollback": "node scripts/production-deploy.js rollback",
    "production:verify": "node scripts/verify-production.js",
    "newsletter:production:build": "node scripts/newsletter-production-deploy.js build",
    "newsletter:production:deploy": "node scripts/newsletter-production-deploy.js deploy",
    "newsletter:production:verify": "node scripts/newsletter-production-deploy.js verify",
    "newsletter:mock": "node scripts/mock-newsletter-endpoint.js",
    "smoke": "node scripts/smoke-test.js"
  },
  "dependencies": {
    "@apollo/react-common": "^3.1.3",
    "@apollo/react-hooks": "^3.1.3",
    "@apollo/react-ssr": "^3.1.3",
    "@emotion/core": "^10.0.17",
    "@emotion/styled": "^10.0.12",
    "@sls-next/lambda-at-edge": "^1.4.1-alpha.2",
    "apollo-boost": "0.4.4",
    "apollo-cache-inmemory": "^1.6.3",
    "apollo-client": "^2.6.4",
    "apollo-link": "1.2.13",
    "apollo-link-context": "^1.0.19",
    "apollo-link-http": "^1.5.16",
    "apollo-link-retry": "2.2.15",
    "aws-sdk": "2.517.0",
    "axios": "0.19.0",
    "babel-polyfill": "6.26.0",
    "bootstrap": "^3.3.7",
    "cookie": "0.4.0",
    "cowsay-browser": "^1.1.8",
    "dayjs": "1.8.16",
    "deep-map-keys": "2.0.1",
    "dotenv": "8.1.0",
    "eslint-plugin-graphql": "3.0.3",
    "google-map-react": "1.1.5",
    "graphql": "^14.5.3",
    "graphql-tag": "2.10.1",
    "https-proxy-agent": "4.0.0",
