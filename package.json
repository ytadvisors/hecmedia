{
  "name": "hecmedia",
  "version": "1.0.0",
  "description": "HEC Media ReactJS application setup to run with nextjs and serverless",
  "main": "index.js",
  "repository": {
    "type": "git",
    "url": "git@github.com:ytadvisors/hecmedia.git"
  },
  "keywords": [
    "serverless",
    "nextjs",
    "lambda"
  ],
  "author": "YT Advisors <admin@ytadvisors.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/ytadvisors/hecmedia/issues"
  },
  "jest": {
    "automock": false,
    "testRegex": "\\.test\\.js$",
    "moduleNameMapper": {
      "\\.(css|less|sass|scss)$": "<rootDir>/__mocks__/jest/styleMock.js",
      "\\.(gif|ttf|eot|svg|png)$": "<rootDir>/__mocks__/jest/fileMock.js"
    }
  },
  "husky": {
    "hooks": {
      "pre-commit": "NODE_ENV=production lint-staged"
    }
  },
  "lint-staged": {
    "*.{js,jsx,css}": [
      "pretty-quick --staged",
      "eslint ./ --fix ",
      "git add"
    ]
  },
  "homepage": "https://github.com/ytadvisors/hecmedia#readme",
  "scripts": {
    "dev": "next",
    "build": "next build",
    "start": "next start",
    "deploy": "yarn build && sls deploy"
  },
  "dependencies": {
    "@zeit/next-css": "1.0.1",
    "@zeit/next-sass": "1.0.1",
    "bootstrap": "4.3.1",
    "cowsay-browser": "^1.1.8",
    "next": "^8.0.3",
    "next-aws-lambda": "^2.0.5-alpha.0",
    "node-sass": "4.12.0",
    "react": "^16.8.4",
    "react-bootstrap": "1.0.0-beta.12",
    "react-datepicker": "2.8.0",
    "react-dates": "20.3.0",
    "react-dom": "^16.8.4",
    "react-google-maps": "9.4.5",
    "react-icons": "3.7.0",
    "react-lazyload": "2.6.2",
    "react-player": "1.12.0",
    "react-recaptcha": "2.3.10",
    "react-select": "3.0.4",
    "react-share": "3.0.0",
    "slick-carousel": "1.8.1",
    "validator": "11.1.0"
  },
  "devDependencies": {
    "@babel/preset-env": "7.5.5",
    "@babel/preset-flow": "^7.0.0",
    "@babel/preset-react": "7.0.0",
    "babel-eslint": "9.x",
    "babel-jest": "24.8.0",
    "core-js": "^3.1.3",
    "eslint": "^6.2.2",
    "eslint-config-airbnb": "^17.1.0",
    "eslint-config-prettier": "^3.1.0",
    "eslint-plugin-import": "^2.14.0",
    "eslint-plugin-jsx-a11y": "^6.1.2",
    "eslint-plugin-prettier": "^3.0.0",
    "eslint-plugin-react": "7.14.3",
    "husky": "^1.1.2",
    "jest": "24.9.0",
    "lint-staged": "^7.3.0",
    "prettier": "1.18.2",
    "pretty-quick": "1.11.1",
    "serverless": "^1.39.1",
    "serverless-nextjs-plugin": "^1.2.0",
    "serverless-offline": "5.10.1",
    "webpack": "4.39.2"
  }
}
